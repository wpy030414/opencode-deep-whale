{
  "name": "personalized-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "build-tokens": "pnpm --filter @skins/core build",
    "build-mapping": "pnpm --filter @skins/opencode build-mapping && pnpm --filter @skins/qwenwork build-mapping",
    "preview": "pnpm --filter @skins/core preview",
    "dev:opencode": "node scripts/dev-opencode.mjs",
    "apply:opencode": "pnpm --filter @skins/opencode apply",
    "dev:qwenwork": "node scripts/dev-qwenwork.mjs",
    "apply:qwenwork": "pnpm --filter @skins/qwenwork apply"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
